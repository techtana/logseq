<?xml version="1.0" encoding="utf-8"?>
<!-- Chevrons lighting up one after another, pointing away from the mic. Drawn for the right of the mic. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="32dp"
            android:height="32dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="chevron1"
                android:pathData="M3,7L8,12L3,17"
                android:strokeWidth="2.4"
                android:strokeAlpha="0.3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:name="chevron2"
                android:pathData="M10,7L15,12L10,17"
                android:strokeWidth="2.4"
                android:strokeAlpha="0.3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:name="chevron3"
                android:pathData="M17,7L22,12L17,17"
                android:strokeWidth="2.4"
                android:strokeAlpha="0.3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </aapt:attr>
    <target android:name="chevron1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.3" />
                    <keyframe android:fraction="0.15" android:value="1" />
                    <keyframe android:fraction="0.45" android:value="0.3" />
                    <keyframe android:fraction="1" android:value="0.3" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="chevron2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.3" />
                    <keyframe android:fraction="0.15" android:value="0.3" />
                    <keyframe android:fraction="0.3" android:value="1" />
                    <keyframe android:fraction="0.6" android:value="0.3" />
                    <keyframe android:fraction="1" android:value="0.3" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="chevron3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="strokeAlpha"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.3" />
                    <keyframe android:fraction="0.3" android:value="0.3" />
                    <keyframe android:fraction="0.45" android:value="1" />
                    <keyframe android:fraction="0.75" android:value="0.3" />
                    <keyframe android:fraction="1" android:value="0.3" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
