<?xml version="1.0" encoding="utf-8"?>
<!-- Equalizer bars bouncing next to the mic. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="32dp"
            android:height="32dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="bar1"
                android:pathData="M4,3.5V20.5"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathStart="0.3"
                android:trimPathEnd="0.7" />
            <path
                android:name="bar2"
                android:pathData="M9.33,3.5V20.5"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathStart="0.1"
                android:trimPathEnd="0.9" />
            <path
                android:name="bar3"
                android:pathData="M14.67,3.5V20.5"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathStart="0.2"
                android:trimPathEnd="0.8" />
            <path
                android:name="bar4"
                android:pathData="M20,3.5V20.5"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round"
                android:trimPathStart="0.05"
                android:trimPathEnd="0.95" />
        </vector>
    </aapt:attr>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="trimPathStart"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.3" />
                    <keyframe android:fraction="0.25" android:value="0.05" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.25" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.3" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="trimPathEnd"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.7" />
                    <keyframe android:fraction="0.25" android:value="0.95" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.75" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.9" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="trimPathStart"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.1" />
                    <keyframe android:fraction="0.25" android:value="0.3" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.2" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="trimPathEnd"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.9" />
                    <keyframe android:fraction="0.25" android:value="0.7" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.8" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.9" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="trimPathStart"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.2" />
                    <keyframe android:fraction="0.25" android:value="0" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.35" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.05" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.2" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="trimPathEnd"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.8" />
                    <keyframe android:fraction="0.25" android:value="1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.65" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.95" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.8" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="bar4">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:repeatCount="infinite">
                <propertyValuesHolder
                    android:propertyName="trimPathStart"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.05" />
                    <keyframe android:fraction="0.25" android:value="0.25" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.1" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.38" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.05" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
                <propertyValuesHolder
                    android:propertyName="trimPathEnd"
                    android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.95" />
                    <keyframe android:fraction="0.25" android:value="0.75" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.5" android:value="0.9" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="0.75" android:value="0.62" android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe android:fraction="1" android:value="0.95" android:interpolator="@android:interpolator/fast_out_slow_in" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
